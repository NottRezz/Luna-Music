# Luna Music — Supabase (ADR 4)
#
# Create a free project at https://supabase.com, then paste the Project URL
# and anon (public) key from Project Settings → API.
#
# After setting these, run the SQL in supabase/migrations/20260810000000_luna_schema.sql
# in the Supabase SQL Editor (or `supabase db push` if you use the CLI).

# Project URL looks like https://abcdxyz.supabase.co — NOT a dashboard/settings link.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use either the legacy anon JWT (eyJ...) or the new publishable key (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
